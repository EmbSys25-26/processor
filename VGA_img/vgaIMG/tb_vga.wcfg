<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_vga_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_vga" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="2,902.087667 us"></ZoomStartTime>
      <ZoomEndTime time="3,372.087668 us"></ZoomEndTime>
      <Cursor1Time time="125.740000 us"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="215"></NameColumnWidth>
      <ValueColumnWidth column_width="97"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="14" />
   <wvobject type="logic" fp_name="/tb_vga/rst">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
