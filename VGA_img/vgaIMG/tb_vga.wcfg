<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_vga_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_vga" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000000000 ms"></ZoomStartTime>
      <ZoomEndTime time="23.800000001 ms"></ZoomEndTime>
      <Cursor1Time time="20.041000000 ms"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="215"></NameColumnWidth>
      <ValueColumnWidth column_width="107"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="14" />
   <wvobject type="logic" fp_name="/tb_vga/clk_pixel">
      <obj_property name="ElementShortName">clk_pixel</obj_property>
